<Window
    x:Class="AegisForecast.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Quant Scenario Studio by LAI ZEYU">
  <Grid x:Name="Root" Background="#07131F" RequestedTheme="Dark">
    <WebView2 x:Name="Browser" Visibility="Collapsed" />
    <Grid x:Name="StatusPanel" Padding="32">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Spacing="14">
        <ProgressRing x:Name="Progress" IsActive="True" Width="42" Height="42" />
        <TextBlock Text="Quant Scenario Studio by LAI ZEYU" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Authored by LAI ZEYU（来泽宇） · Powered by Aegis Forecast" FontSize="12" HorizontalAlignment="Center" Opacity="0.62" />
        <TextBlock x:Name="StatusText" Text="正在启动只读研究引擎…" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.82" />
        <TextBlock Text="Store 版仅提供离线只读研究；不包含交易、账户连接或调度模块。" TextWrapping="Wrap" TextAlignment="Center" Foreground="#F2B35D" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
